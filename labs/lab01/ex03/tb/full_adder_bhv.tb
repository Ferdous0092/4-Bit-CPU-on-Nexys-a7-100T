entity full_adder_bhv_tb is
end full_adder_bhv_tb;

architecture bench of full_adder_bhv_tb is

    -- testbench signals
    signal A    : bit;
    signal B    : bit;
    signal CIN  : bit;
    signal S    : bit;
    signal COUT : bit;

    -- component to be tested
    component full_adder_bhv
        port(
            A    : in bit;
            B    : in bit;
            CIN  : in bit;
            S    : out bit;
            COUT : out bit
        );
    end component;

begin

    -- connect the full adder to the testbench signals
    fa: full_adder_bhv
        port map(
            A    => A,
            B    => B,
            CIN  => CIN,
            S    => S,
            COUT => COUT
        );

    -- apply all possible input combinations
    process
    begin

        -- 0 + 0 + 0
        A <= '0';
        B <= '0';
        CIN <= '0';
        wait for 10 ns;

        -- 0 + 0 + 1
        A <= '0';
        B <= '0';
        CIN <= '1';
        wait for 10 ns;

        -- 0 + 1 + 0
        A <= '0';
        B <= '1';
        CIN <= '0';
        wait for 10 ns;

        -- 0 + 1 + 1
        A <= '0';
        B <= '1';
        CIN <= '1';
        wait for 10 ns;

        -- 1 + 0 + 0
        A <= '1';
        B <= '0';
        CIN <= '0';
        wait for 10 ns;

        -- 1 + 0 + 1
        A <= '1';
        B <= '0';
        CIN <= '1';
        wait for 10 ns;

        -- 1 + 1 + 0
        A <= '1';
        B <= '1';
        CIN <= '0';
        wait for 10 ns;

        -- 1 + 1 + 1
        A <= '1';
        B <= '1';
        CIN <= '1';
        wait for 10 ns;

        -- stop simulation
        wait;

    end process;

end bench;
